    console.log('componentDidMount');
    // runs ONCE when component first appears on screen
    // good for: API calls, fetching data, timers, event listeners
}

// 2. Component updates - state or props changed
componentDidUpdate(prevProps, prevState) {
    console.log('componentDidUpdate');
    // runs every time state or props changes
    // prevProps = props before update
    // prevState = state before update
    // good for: saving data, comparing old vs new values
}

// 3. Component dies - removed from page
componentWillUnmount() {
    console.log('componentWillUnmount');
    // runs just before component is removed
    // good for: cleanup, clearing timers, removing listeners
}
```

---

**Lifecycle order:**
```
Component Created
      ↓
constructor()        → sets up state
      ↓
render()             → displays UI
      ↓
componentDidMount()  → runs after first render
      ↓
state/props changes
      ↓
render()             → re-renders UI
      ↓
componentDidUpdate() → runs after every update
      ↓
component removed
      ↓
componentWillUnmount() → cleanup

